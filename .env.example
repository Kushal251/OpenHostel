# ======================================================
# OpenHostel Environment Variables
# Copy this file to .env before running the project.
# ======================================================

# ------------------------------------------------------
# Database
# ------------------------------------------------------
DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/openhostel"

# ------------------------------------------------------
# Authentication
# ------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# ------------------------------------------------------
# Email (Password Reset)
# ------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="OpenHostel <your-email@gmail.com>"

# ------------------------------------------------------
# File Uploads (Payment Screenshots / Menu Images)
# ------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ------------------------------------------------------
# QR & Security
# ------------------------------------------------------
QR_SECRET="replace-with-random-qr-secret"

# ------------------------------------------------------
# Application
# ------------------------------------------------------
NODE_ENV="development"